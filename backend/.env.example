# Run workspace commands from the repository root. Never use a VITE_ prefix for secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://localhost:5173
# Supply your own local PostgreSQL database. No database is provisioned automatically.
DATABASE_URL=postgresql://munk:replace-me@127.0.0.1:5432/munk
# Optional dedicated native test database, never a production URL:
# TEST_DATABASE_URL=postgresql://munk:replace-me@127.0.0.1:5432/munk_test
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# Optional override; relative paths resolve against backend/, independently of shell cwd.
MEDIA_ROOT=.data/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
LOG_LEVEL=info
# MUNK Development app; secret goes only in ignored backend/.env.
PRIVY_APP_ID=cmvrdnznc00we0glcf33db0xh
PRIVY_APP_SECRET=
