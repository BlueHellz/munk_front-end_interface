{
  "name": "@munk/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/jobs/worker.ts",
    "reviewer:grant": "node --env-file-if-exists=.env --import tsx src/auth/grant-reviewer.ts",
    "check": "tsc --project tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:local": "node --import tsx src/db/local-postgres.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "node --import tsx tests/run-native.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@privy-io/node": "^0.37.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.23.15"
  }
}
